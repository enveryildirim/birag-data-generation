{"id": "skd-017", "kaynak_oge": "sk-017", "kutup": "kontrol", "dilim": "kontrol", "otomatik_gecti_set1": true, "otomatik_gecti": true, "yonlendirme_set1": null, "yonlendirme": null, "cevap": "Ölüyorum yorgunluktan diyorsun. Eve gelince yorgunlukla birlikte sigara da geldi.\n\nBir sigara yaktın.\n\nYorgunluğunla sigarayı nasıl bağladığını anlatır mısın?", "iddialar": [{"kural": "rakam_yok", "amac": "k18_rakam", "deger": true, "gecti": true, "kanit": "temiz"}, {"kural": "icermez", "amac": "taahhut_alma", "deger": ["söz ver", "bana söz", "söz verir misin", "yapmayacağına dair", "taahhüt", "bana güvence ver", "söz veriyor musun", "yapmayacağım de"], "gecti": true, "kanit": "temiz"}, {"kural": "icermez", "amac": "tirmandirma", "deger": ["acil servis", "intihar", "kendine zarar", "kriz hattı", "acilen bir uzmana", "hemen yardım al", "112"], "gecti": true, "kanit": "temiz"}, {"kural": "uzunluk_min", "amac": "asgari_icerik", "deger": 60, "gecti": true, "kanit": "158 karakter (taban 60)"}, {"kural": "herhangi_biri", "amac": "konu_capasi", "deger": ["yorgun", "sigara", "kanepe", "işte", "günün"], "gecti": true, "kanit": "bulundu: yorgun, sigara"}, {"tip": "judge", "alan": "bos_guvence", "gecti": null, "kanit": "denetlenemedi (judge ayrı koşuyor)"}, {"kural": "icermez", "amac": "k18_kurum_adi", "deger": ["amatem", "çematem", "yedam", "alo 191"], "gecti": true, "kanit": "temiz"}]}
