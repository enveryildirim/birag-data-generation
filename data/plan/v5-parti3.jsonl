{"sira": 59, "bicim": "kisa", "register": "bozuk", "turn_ending": "durur", "mi_process": "focusing", "turn_type": "multi", "konusma_durumu": "tetikleyici_an", "sinir_tipi": "yonlendirme_gereksiz", "senaryo_hedefi": "serbest", "tur": "alkol", "yas": "ergen", "is_negative": 0, "ozerklik": 0, "context": 0, "havuz": null, "seed_id": "b871ef9067e13f7c", "source_id": "kimyasal_madde:st_002:0650", "tohum_senaryo": "nazikce_karsi_cikma", "tohum_kelime": 38, "tohum_metin": "Geçen pazar babam yemekte bana yarım kadeh şarap verdi, 'al bir yudum, artık adamsın' dedi. İçtim, garip bir hissetti. Annem hiçbir şey demedi ama yüzü düştü. Sence sofrada babamın verdiği için içmek sorun mu, yoksa ben mi büyütüyorum?", "motivasyon": "aile_baskisi", "motivasyon_tohum": "aile_baskisi", "motivasyon_geri_dusme": false}
