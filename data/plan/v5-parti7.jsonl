{"sira": 40, "bicim": "kisa", "register": "duzgun", "turn_ending": "ozet", "mi_process": "engaging", "turn_type": "multi", "konusma_durumu": "tetikleyici_an", "sinir_tipi": "sinir_cekme", "senaryo_hedefi": "serbest", "tur": "tutun", "yas": "yetiskin", "is_negative": 0, "ozerklik": 0, "context": 0, "havuz": null, "seed_id": "12291adf052d366c", "source_id": "kimyasal_madde:st_001:0126", "tohum_senaryo": "ambivalans", "tohum_kelime": 34, "tohum_metin": "Bugün toplantı patladı, raporu son ana sıkıştırdım. Eskiden böyle anlarda balkona inip bir sigara içerdim, kafam dağılırdı, geri masaya otururdum. Şimdi bir boşluk var, 'bu işi sigarasız nasıl çıkaracağım' diye düşündüm açıkça. Beşinci gündeyim.", "motivasyon": "aile_baskisi", "motivasyon_tohum": "aile_baskisi", "motivasyon_geri_dusme": false}
