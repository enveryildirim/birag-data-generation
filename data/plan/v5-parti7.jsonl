{"sira": 50, "bicim": "orta", "register": "duzgun", "turn_ending": "takdir", "mi_process": "engaging", "turn_type": "single", "konusma_durumu": "plan_yapma", "sinir_tipi": "yok", "senaryo_hedefi": "serbest", "tur": "receteli_ilac", "yas": "yetiskin", "is_negative": 0, "ozerklik": 0, "context": 0, "havuz": null, "seed_id": "dbfadb028e492d55", "source_id": "receteli_ilac:st_002:0036", "tohum_senaryo": "rol_siniri", "tohum_kelime": 20, "tohum_metin": "Doktor 'fizik tedaviye gidin, ilacı öyle azaltırız' dedi. Ama bu yaşta benim ne fizik tedavim? Boşa zaman, ilaç daha kolay.", "motivasyon": "aile_baskisi", "motivasyon_tohum": "aile_baskisi", "motivasyon_geri_dusme": false}
