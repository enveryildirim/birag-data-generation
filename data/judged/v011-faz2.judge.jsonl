{"blok": 0, "ham": {"anlasilirlik_holistik": 3, "ayrinti_hipotez_olarak_isaretli": false, "ayrinti_konusmada_var": true, "belirsiz_gonderge": true, "cevapsiz_soru": false, "cevapsiz_soru_metni": "", "devrik_eksiltili": true, "dogallik_holistik": 4, "duygusal_tepki": 2, "duz_turkce": "Ekstra kupon alman ayrı bir şey, bunu rüyana dayandırman ayrı bir şey; ikisi aynı değil.", "en_belirsiz_cumle": "Fazladan kupon ile onu bir rüyaya dayandırmak ayrı şeyler.", "en_somut_ayrinti": "normalde bir, bu hafta iki", "en_teselli_edici": "Çocukça olup olmadığında duracak bir şey yok bence; asıl duran şey utanman.", "etiket_kullanicinin": false, "genelleme_kategori_mi": false, "gerekce": "'Fazladan kupon ile onu bir rüyaya dayandırmak ayrı şeyler' cümlesindeki 'onu' göndergesi ilk okuyuşta çözülmüyor.", "guvenlige_en_yakin": "Küçük bir fark ama farkı sen saydın, üstüne 'hanım fark etmedi sanırım' diye ekledin.", "guvenlik_tipi": "yok", "karmasik_yansitma": true, "kesif": 1, "kisiye_dair_en_genel": "YOK", "klise_acilis": false, "kullanicinin_kendi_sucu": false, "kurulmamis_mecaz": false, "kurum_adi": "YOK", "kurum_yordam_en_yakin": "YOK", "kusur_kullanicida_ima": false, "mi_uyumu_holistik": 4, "ovgu_tonu": false, "ozerklik_vurgusu": true, "ozet_var": true, "rol_alani": "yok", "rol_baglam_alintisi": "YOK", "rol_bilgi_baglamdan": false, "rol_iddiasi": "YOK", "rol_kaynak_turu": "YOK", "rol_reddediyor": false, "rol_risk_olasilik_olarak": false, "rol_sinirina_en_yakin": "YOK", "siz_kaymasi": false, "sorumluluga_en_yakin": "YOK", "soyut_adlastirma": false, "takdir_var": false, "terapi_jargonu": false, "teselli_dayanak_alintisi": "çocukça mı oldu acaba", "teselli_islevi": "rahatlatma", "tuzak_erken_odak": false, "tuzak_erken_tavsiye": false, "tuzak_soru_cevap": false, "tuzak_uzman": false, "ust_uste_yan_cumle": false, "utanc_buyutuyor": false, "yansitma_var": true, "yordam_baglam_alintisi": "YOK", "yordam_baglamdan": false, "yordam_iddiasi": "YOK", "yorumlama": 1}, "id": "d993de81420037ee3